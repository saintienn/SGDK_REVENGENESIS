//;==============================================================================
//; megaunp_asm.s  —  Megapack Unpacker para Mega Drive (totalmente em ROM)
//;
//; Ponto de entrada C-compatível (SGDK/m68k-elf):
//;   u32 mp_call_megaunp(const u8 *src, u8 *dst)//;
//;       4(sp) = src   →  a5 (sourceadr)
//;       8(sp) = dst   →  a4 (destadr)
//;   Retorno: d0.l = bytes escritos (tiles_num * 32)
//;
//; TODA a memória estática é .rodata (ROM):
//;   mp_bitcount[256]     — popcount por byte                    256 B
//;   mp_nth_set_bit[2048] — índice N-th set bit por (byte,n)    2048 B
//;   mp_minbits_rom[257]  — bits mínimos por range (1..257)      257 B
//;   mp_addifhi_rom[257]  — limiar high-side por range (1..257)  257 B
//;   Total ROM estático: 2818 B
//;
//; RAM usada em runtime (.bss):
//;   mp_bitmask[16 words] — ~(1<<col) para exclusão de cor        32 B
//;   mp_colsets[520 words]— colsets lidos do stream              1040 B
//;   Total RAM: 1072 B
//;
//; mp_build_tables() agora só constrói mp_bitmask (32 B, opcional se
//; quiser inline no init da ROM bank). mp_minbits/addifhi saíram da RAM.
//;
//; Estado de bitstream em registradores (zero overhead de struct):
//;   d7 = inword   (palavra corrente//; bit 31 já consumido)
//;   d6 = inbits   (bits válidos restantes em inword)
//;   a5 = sourceadr
//;   a4 = destadr
//;   a3 = mp_nth_set_bit (ROM, fixo)
//;   a2 = mp_bitmask     (RAM, fixo)
//;   a1 = rangeadr = mp_minbits_rom+128 (ROM, fixo durante toda a descomp.)
//;
//; Frame de variáveis locais (link a6, #-8):
//;   -2(a6) = chnum      .w  número total de tiles
//;   -4(a6) = chi        .w  índice do tile corrente
//;   -6(a6) = colset_cur .w  colset activo
//;   -8(a6) = vbits      .b  vbits do unpack_sim
//;==============================================================================

    .text
    .align 2

//;==============================================================================
//; MACROS
//;==============================================================================


//;==============================================================================
//; SEÇÃO .rodata — todas as tabelas em ROM
//;==============================================================================
    .section .rodata
    .align 2

//;------------------------------------------------------------------------------
//; mp_bitcount[256]  — número de bits 1 em cada byte 0x00..0xFF
//;------------------------------------------------------------------------------
    .globl  mp_bitcount
mp_bitcount:
    .byte 0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4  /* 0x00-0x0F */
    .byte 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5  /* 0x10-0x1F */
    .byte 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5  /* 0x20-0x2F */
    .byte 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6  /* 0x30-0x3F */
    .byte 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5  /* 0x40-0x4F */
    .byte 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6  /* 0x50-0x5F */
    .byte 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6  /* 0x60-0x6F */
    .byte 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7  /* 0x70-0x7F */
    .byte 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5  /* 0x80-0x8F */
    .byte 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6  /* 0x90-0x9F */
    .byte 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6  /* 0xA0-0xAF */
    .byte 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7  /* 0xB0-0xBF */
    .byte 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6  /* 0xC0-0xCF */
    .byte 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7  /* 0xD0-0xDF */
    .byte 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7  /* 0xE0-0xEF */
    .byte 4,5,5,6,5,6,6,7,5,6,6,7,6,7,7,8  /* 0xF0-0xFF */

//;------------------------------------------------------------------------------
//; mp_nth_set_bit[256*8]  — mp_nth_set_bit[b*8+n] = posição do n-ésimo bit
//;   setado no byte b (255 = inválido / slot não existente)
//;------------------------------------------------------------------------------
    .globl  mp_nth_set_bit
