static u16 mp_colsets[MP_MAX_COLSETS];


/* ── mp_read_bits ───────────────────────────────────────────────── */
static __attribute__((always_inline)) u16 mp_read_bits(mp_bs_t *s, u8 num_bits) {
    register u32       cmp  = s->cmp;
    register u8        used = s->used;
    register const u8 *src  = s->src;

    while (num_bits > 0) {
        if (used == 0) {
            cmp |= (*src++) << 8;
            cmp |= (*src++);
            used = 16;
        }

        int take = (num_bits < used) ? num_bits : used;

        cmp <<= take;
        used -= take;
        num_bits -= take;
    }

    s->cmp = cmp & 0xFFFF;
    s->used = used;
    s->src  = src;
    return (u16)(cmp >> 16);
}

/* ── mp_get_stream ──────────────────────────────────────────────── */
static u32 mp_get_stream(mp_bs_t *s, u32 range) {
    if (range > 0x100) {
        range--;
        u32 low = (range & 0xFF) + 1;
        u32 hi  = (range >> 8) + 1;
        u32 xhi = mp_get_stream(s, hi);
        if (xhi > 0)
            return mp_read_bits(s, 8) + (xhi - 1) * 256 + low;
        return mp_get_stream(s, low);
    }
    u32 tmp = range, bc = 0;
    while (tmp > 1) {
        bc++;
        tmp >>= 1;
    }
    u32 unused = (1u << (bc + 1)) - range;
    u32 x = mp_read_bits(s, (u8)bc);
    if (x < unused) return x;
    return ((x << 1) | mp_read_bits(s, 1)) - unused;
}

/* ── mp_pixstream / mp_mpixstream ───────────────────────────────── */
static __attribute__((always_inline)) u8 mp_pixstream(mp_bs_t *s, u16 col_set) {
    u8 lo  = (u8)col_set;
    u8 hi  = (u8)(col_set >> 8);
    u8 loc = mp_bitcount[lo];
    u8 n   = (u8)(loc + mp_bitcount[hi]);
    u16 idx = (u16)mp_get_stream(s, n);
    if (idx < loc)
        return mp_nth_set_bit[(u16)lo * 8 + idx];
    return mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;
}

static __attribute__((always_inline)) u8 mp_mpixstream(mp_bs_t *s, u8 pixel, u16 pixels) {
    pixels &= ~(1u << pixel);
    return mp_pixstream(s, pixels);
}

/* ── mp_unpack_sim ──────────────────────────────────────────────── */
static void mp_unpack_sim(mp_bs_t *s, u8 *dst, u32 i, u16 pixels, u32 offset) {
    u8 *tile_i   = dst + i      * MP_TILE_SIZE;
    u8 *tile_ref = dst + offset * MP_TILE_SIZE;

    u8 vmap = 0;
    if (mp_read_bits(s, 1)) vmap = (u8)((mp_get_stream(s, 0x0F) ^ 0x0F) << 4);
    if (mp_read_bits(s, 1)) {
        vmap |= 0x0F;
        vmap ^= (u8)mp_get_stream(s, 0x0F);
    }

    u8 vmask[8];
    for (u8 i = 0; i < 8; i++)
        vmask[i] = (vmap >> i) & 1;

    u8 hmap = 0;
    if (mp_read_bits(s, 1)) hmap = (u8)((mp_get_stream(s, 0x0F) ^ 0x0F) << 4);
    if (mp_read_bits(s, 1)) {
        hmap |= 0x0F;
        hmap ^= (u8)mp_get_stream(s, 0x0F);
    }

    // FAST PATH: tile inteiro igual ao de referência
    if (hmap == 0xFF && vmap == 0xFF) {
        u32 *d = (u32*)tile_i;
        u32 *r = (u32*)tile_ref;

        d[0] = r[0];
        d[1] = r[1];
        d[2] = r[2];
        d[3] = r[3];
        d[4] = r[4];
        d[5] = r[5];
        d[6] = r[6];
        d[7] = r[7];

        return;
    }



    for (u8 row = 0; row < 8; row++) {
        u8 y        = 7 - row;
        u8 *dst_row = tile_i   + row * 4;
        u8 *ref_row = tile_ref + row * 4;

        if (hmap & (1 << y)) {
            *(u32*)dst_row = *(u32*)ref_row;
        } else {
            // FAST PATH: linha idêntica ao tile de referência
            if (vmap == 0xFF) {
                *(u32*)dst_row = *(u32*)ref_row;
                continue;
            }

            u8 vmaptmp = vmap;
            if ((hmap | (1 << y)) != 0xFF) {
                for (s8 x = 7; x >= 0; x--) {
                    if (vmaptmp == 0xFE || vmaptmp == 0xFD || vmaptmp == 0xFB ||
                            vmaptmp == 0xF7 || vmaptmp == 0xEF || vmaptmp == 0xDF ||
                            vmaptmp == 0xBF || vmaptmp == 0x7F) break;
                    if (!vmask[x])
                        vmaptmp |= (u8)(mp_read_bits(s, 1) << x);
                }
            }
            u8 vtmpmask[8];
            for (u8 i = 0; i < 8; i++)
                vtmpmask[i] = (vmaptmp >> i) & 1;

            static const u8 xe_lut[4] = {7, 5, 3, 1};
            static const u8 xo_lut[4] = {6, 4, 2, 0};

            /*for (u8 b = 0; b < 4; b++) {
                u8 ref  = ref_row[b];
                u8 xe   = xe_lut[b];
                u8 xo   = xo_lut[b];
                u8 re   = ref >> 4;
                u8 ro   = ref & 0x0F;
                u8 pe   = vtmpmask[xe] ? re : mp_mpixstream(s, re, pixels);
                u8 po   = vtmpmask[xo]  ? ro : mp_mpixstream(s, ro, pixels);
                dst_row[b] = (u8)((pe << 4) | po);
            }
            otimização de fluxo linear (ótimo pro 68000) desmontagem do loop fixo
            */

            // b = 0
            {
                u8 ref = ref_row[0];
                u8 re = ref >> 4;
                u8 ro = ref & 0x0F;

                //u8 pe = vtmpmask[7] ? re : mp_mpixstream(s, re, pixels);
                u8 pe;
                if (vtmpmask[7]) {
                    pe = re;
                } else {
                    u16 p = pixels & ~(1u << re);
                    pe = mp_pixstream(s, p);
                }

                //u8 po = vtmpmask[6] ? ro : mp_mpixstream(s, ro, pixels);
                u8 po;
                if (vtmpmask[6]) {
                    po = ro;
                } else {
                    u16 p = pixels & ~(1u << ro);
                    po = mp_pixstream(s, p);
                }

                dst_row[0] = (u8)((pe << 4) | po);
            }

            // b = 1
            {
                u8 ref = ref_row[1];
                u8 re = ref >> 4;
                u8 ro = ref & 0x0F;


                //u8 pe = vtmpmask[5] ? re : mp_mpixstream(s, re, pixels);
                u8 pe;
                if (vtmpmask[5]) {
                    pe = re;
                } else {
                    u16 p = pixels & ~(1u << re);
                    pe = mp_pixstream(s, p);
                }

                //u8 po = vtmpmask[4] ? ro : mp_mpixstream(s, ro, pixels);
                u8 po;
                if (vtmpmask[4]) {
                    po = ro;
                } else {
                    u16 p = pixels & ~(1u << ro);
                    po = mp_pixstream(s, p);
                }

                dst_row[1] = (u8)((pe << 4) | po);
            }

            // b = 2
            {
                u8 ref = ref_row[2];
                u8 re = ref >> 4;
                u8 ro = ref & 0x0F;


                //u8 pe = vtmpmask[3] ? re : mp_mpixstream(s, re, pixels);
                u8 pe;
                if (vtmpmask[3]) {
                    pe = re;
                } else {
                    u16 p = pixels & ~(1u << re);
                    pe = mp_pixstream(s, p);
                }

                //u8 po = vtmpmask[2] ? ro : mp_mpixstream(s, ro, pixels);
                u8 po;
                if (vtmpmask[2]) {
                    po = ro;
                } else {
                    u16 p = pixels & ~(1u << ro);
                    po = mp_pixstream(s, p);
                }

                dst_row[2] = (u8)((pe << 4) | po);
            }

            // b = 3
            {
                u8 ref = ref_row[3];
                u8 re = ref >> 4;
                u8 ro = ref & 0x0F;


                //u8 pe = vtmpmask[1] ? re : mp_mpixstream(s, re, pixels);
                u8 pe;
                if (vtmpmask[1]) {
                    pe = re;
                } else {
                    u16 p = pixels & ~(1u << re);
                    pe = mp_pixstream(s, p);
                }

                //u8 po = vtmpmask[0] ? ro : mp_mpixstream(s, ro, pixels);
                u8 po;
                if (vtmpmask[0]) {
                    po = ro;
                } else {
                    u16 p = pixels & ~(1u << ro);
                    po = mp_pixstream(s, p);
                }

                dst_row[3] = (u8)((pe << 4) | po);
            }
        }
    }
}




/* ── mp_unpack_linerep ──────────────────────────────────────────── */
static void mp_unpack_linerep(mp_bs_t *s, u8 *dst, u32 i, u16 pixels, u16 col_idx) {
    u16 base_pixels = mp_colsets[col_idx];
    u8 tile[8][8];
    //memset(tile, 0, 64);

    u8 hmap = 0;

    if (mp_read_bits(s, 1)) hmap = (u8)((mp_get_stream(s, 0x0F) ^ 0x0F) << 3);
    if (mp_read_bits(s, 1)) {
        hmap |= 7;
        hmap ^= (u8)mp_get_stream(s, 7);
    }
    if (hmap & 8) hmap ^= 7;



    u8 vmap = 0;
    if (mp_read_bits(s, 1)) vmap = (u8)((mp_get_stream(s, 0x0F) ^ 0x0F) << 3);
    if (mp_read_bits(s, 1)) {
        vmap |= 7;
        vmap ^= (u8)mp_get_stream(s, 7);
    }
    if (vmap & 8) vmap ^= 7;

    u8 vmask[8];
    //for (u8 i = 0; i < 8; i++)
    vmask[0] = (vmap >> 0) & 1;
    vmask[1] = (vmap >> 1) & 1;
    vmask[2] = (vmap >> 2) & 1;
    vmask[3] = (vmap >> 3) & 1;
    vmask[4] = (vmap >> 4) & 1;
    vmask[5] = (vmap >> 5) & 1;
    vmask[6] = (vmap >> 6) & 1;
    vmask[7] = (vmap >> 7) & 1;

    //tile[0][0] = mp_pixstream(s, pixels);
    {
        u16 col = pixels;

        u8 lo  = (u8)col;
        u8 hi  = (u8)(col >> 8);
        u8 loc = mp_bitcount[lo];
        u8 n   = loc + mp_bitcount[hi];

        u16 idx = (u16)mp_get_stream(s, n);

        if (idx < loc)
            tile[0][0] = mp_nth_set_bit[(u16)lo * 8 + idx];
        else
            tile[0][0] = mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;
    }


    for (s8 x = 6; x >= 0; x--) {
        if (vmask[x])
            tile[0][7-x] = tile[0][7-x-1];
        else if (mp_read_bits(s, 1)) {
            u16 p = pixels & ~(1u << tile[0][7-x-1]);

            //tile[0][7-x] = mp_pixstream(s, p);
            {
                u16 col = p;

                u8 lo  = (u8)col;
                u8 hi  = (u8)(col >> 8);
                u8 loc = mp_bitcount[lo];
                u8 n   = loc + mp_bitcount[hi];

                u16 idx = (u16)mp_get_stream(s, n);

                if (idx < loc)
                    tile[0][7-x] = mp_nth_set_bit[(u16)lo * 8 + idx];
                else
                    tile[0][7-x] = mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;
            }



        } else
            tile[0][7-x] = tile[0][7-x-1];
    }


    s8 vpref = 1;
    for (s8 y = 6; y >= 0; y--) {
        u8 row = (u8)(7 - y);
        if (hmap & (1 << y)) {
            memcpy(tile[row], tile[row-1], 8);
        } else {
            pixels = base_pixels;
            u8 bit = mp_read_bits(s, 1);
            if (bit) {
                u16 p = pixels & ~(1u << tile[row-1][0]);

                u8 lo  = (u8)p;
                u8 hi  = (u8)(p >> 8);
                u8 loc = mp_bitcount[lo];
                u8 n   = loc + mp_bitcount[hi];

                u16 idx = (u16)mp_get_stream(s, n);

                if (idx < loc)
                    tile[row][0] = mp_nth_set_bit[(u16)lo * 8 + idx];
                else
                    tile[row][0] = mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;
            } else
                tile[row][0] = tile[row-1][0];

            for (s8 x = 6; x >= 0; x--) {
                u8 col = (u8)(7 - x);
                if (vmask[x]) {
                    tile[row][col] = tile[row][col-1];
                } else if (vpref) {
                    u8 bit0 = mp_read_bits(s, 1);

                    if (bit0) {
                        pixels = base_pixels;

                        if (tile[row][col-1] == tile[row-1][col]) {
                            tile[row][col] = mp_mpixstream(s, tile[row][col-1], pixels);
                        } else {
                            u8 bit1 = mp_read_bits(s, 1);

                            if (bit1) {
                                pixels &= ~(1u << tile[row-1][col]);
                                pixels &= ~(1u << tile[row][col-1]);

                                u16 p = pixels;

                                u8 lo  = (u8)p;
                                u8 hi  = (u8)(p >> 8);
                                u8 loc = mp_bitcount[lo];
                                u8 n   = loc + mp_bitcount[hi];

                                u16 idx = (u16)mp_get_stream(s, n);

                                if (idx < loc)
                                    tile[row][col] = mp_nth_set_bit[(u16)lo * 8 + idx];
                                else
                                    tile[row][col] = mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;
                            } else {
                                vpref = 0;
                                tile[row][col] = tile[row-1][col];
                            }
                        }
                    } else tile[row][col] = tile[row][col-1];
                } else {

                    u8 bit0 = mp_read_bits(s, 1);

                    if (!bit0) {
                        tile[row][col] = tile[row-1][col];
                    } else {
                        pixels = base_pixels;

                        if (tile[row][col-1] == tile[row-1][col]) {
                            u16 p = pixels & ~(1u << tile[row][col-1]);

                            u8 lo  = (u8)p;
                            u8 hi  = (u8)(p >> 8);
                            u8 loc = mp_bitcount[lo];
                            u8 n   = loc + mp_bitcount[hi];

                            u16 idx = (u16)mp_get_stream(s, n);

                            if (idx < loc)
                                tile[row][col] = mp_nth_set_bit[(u16)lo * 8 + idx];
                            else
                                tile[row][col] = mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;

                        } else {
                            u8 bit1 = mp_read_bits(s, 1);

                            if (bit1) {
                                pixels &= ~(1u << tile[row-1][col]);
                                pixels &= ~(1u << tile[row][col-1]);

                                u16 p = pixels;

                                u8 lo  = (u8)p;
                                u8 hi  = (u8)(p >> 8);
                                u8 loc = mp_bitcount[lo];
                                u8 n   = loc + mp_bitcount[hi];

                                u16 idx = (u16)mp_get_stream(s, n);

                                if (idx < loc)
                                    tile[row][col] = mp_nth_set_bit[(u16)lo * 8 + idx];
                                else
                                    tile[row][col] = mp_nth_set_bit[(u16)hi * 8 + (idx - loc)] + 8;

                            } else {
                                vpref = 1;
                                tile[row][col] = tile[row][col-1];
                            }
                        }
                    }
                }
            }
        }
    }

    u8 *out = dst + i * MP_TILE_SIZE;


    for (u8 row = 0; row < 8; row++) {
        u8 *t = tile[row], *o = out + row * 4;
        o[0] = (t[0] << 4) | (t[1] & 0x0F);
        o[1] = (t[2] << 4) | (t[3] & 0x0F);
        o[2] = (t[4] << 4) | (t[5] & 0x0F);
        o[3] = (t[6] << 4) | (t[7] & 0x0F);
    }
}

/* ── mp_call_megaunp ────────────────────────────────────────────── */
u32 mp_call_megaunp(const u8 *src, u8 *dst) {
    mp_bs_t state = {0, 0, src};
    mp_bs_t *s = &state;

    u32 tiles_num = mp_read_bits(s, 8) + ((u32)mp_read_bits(s, 2) << 8);
    u32 set_range = (tiles_num > MP_MAX_SET_NUMS) ? (u32)MP_MAX_SET_NUMS : tiles_num;
    u32 set_nums  = mp_get_stream(s, set_range);

    mp_colsets[0]   = mp_read_bits(s, 16);
    u32 num_colsets = 1;
    for (u32 k = 0; k < set_nums; k++) {
        if (mp_read_bits(s, 1)) {
            mp_colsets[num_colsets++] = mp_read_bits(s, 16);
        } else {
            u32 delta    = mp_get_stream(s, num_colsets);
            u32 base_idx = num_colsets - delta - 1;
            u16 col_set  = mp_colsets[base_idx];
            col_set ^= (u16)(1u << mp_read_bits(s, 4));
            mp_colsets[num_colsets++] = col_set;
        }
    }

    // memset(dst, 0, tiles_num * MP_TILE_SIZE);

    u32 used_sets = 0;
    for (u32 i = 0; i < tiles_num; i++) {
        u32 idx = mp_get_stream(s, used_sets + 1);
        if (idx == 0) idx = used_sets++;
        else          idx = used_sets - idx;
        u16 pixels = mp_colsets[idx];

        if (mp_read_bits(s, 1) == 0) {
            u32 off = (0xFFFFFFFFUL ^ mp_get_stream(s, i)) + i;
            mp_unpack_sim(s, dst, i, pixels, off);
        } else {
            mp_unpack_linerep(s, dst, i, pixels, (u16)idx);
        }
    }
    return tiles_num * MP_TILE_SIZE;
}
