#pragma GCC optimize ("O3", "unroll-loops","omit-frame-pointer", "strict-aliasing")
#include "types.h"
#include <string.h>

/*
 * Estado do bitstream em struct compacta.
 * Com O3 + always_inline o GCC mantém os campos em registradores
 * sem precisar de global register asm() (incompatível com LTO do SGDK).
 */
typedef struct {
    unsigned int         cmp;   /* shift register: bits válidos em bits 31..16 */
    unsigned char        used;  /* bits disponíveis                             */
    const unsigned char *src;   /* ponteiro corrente no stream                  */
} mp_bs_t;

#define MP_TILE_SIZE     32
#define MP_MAX_SET_NUMS  512
#define MP_MAX_COLSETS   (MP_MAX_SET_NUMS + 4)

/* ── Lookup tables em ROM ── */
