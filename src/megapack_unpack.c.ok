        r, s.cmp, (u32)s.used);
}*/


u32 mp_read_bits_asm(u32 cmp, u32 num_bits);



u32 rare_count = 0;
u32 common_count = 0;

static inline __attribute__((always_inline)) u32 mp_read_bits(mp_bs_t *s, u8 num_bits) {
    u32 cmp  = s->cmp;
    u32 used = s->used;
    const u8 *src = s->src;

    if (__builtin_expect(used == 0, 0)) {
        cmp  = ((u32)src[0] << 24) | ((u32)src[1] << 16);
        src += 2;
        used = 16;
        s->src = src;
    }

    if (__builtin_expect((u8)num_bits <= (u8)used, 1)) {
        common_count++;
        u32 result = mp_read_bits_asm(cmp, num_bits);  /* ASM faz o shift+extract */
        s->cmp  = cmp << num_bits;                      /* C atualiza cmp */
        s->used = (u8)(used - num_bits);
        return result;
    }

    /* caso raro em C */
    rare_count++;
    /*u8  first = (u8)used;
    u32 hi    = cmp >> (32 - first);
    num_bits -= first;
    cmp  = ((u32)src[0] << 24) | ((u32)src[1] << 16);
    s->src = src + 2;
    used = 16;
    u32 result = (hi << num_bits) | (cmp >> (32 - num_bits));
    s->cmp  = cmp << num_bits;
    s->used = (u8)(used - num_bits);*/

    u8  first = (u8)used;
    num_bits -= first;
    u32 hi    = mp_read_bits_asm(cmp, first);        /* reusa o ASM existente! */
    cmp  = ((u32)src[0] << 24) | ((u32)src[1] << 16);
    s->src = src + 2;
    u32 lo  = mp_read_bits_asm(cmp, num_bits);       /* reusa o ASM existente! */
    u32 result = (hi << num_bits) | lo;
    s->cmp  = cmp << num_bits;
    s->used = (u8)(16 - num_bits);

    return result;

}

