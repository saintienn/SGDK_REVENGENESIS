.text
    .align  2
    .globl  mp_read_bits_asm
mp_read_bits_asm:
    move.l  4(%sp),%d0          //;d0 = cmp
    moveq   #16,%d1
    sub.l   8(%sp),%d1          //;d1 = 16 - num_bits
    //;clr.w   %d0
    swap    %d0                 //;bits válidos em 15..0
    lsr.w   %d1,%d0             //;d0 = result
    rts
